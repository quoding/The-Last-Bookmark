LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1536
DATABASE_URL=postgresql+psycopg://tainai:tainai@localhost:5433/tainai
INVITE_CODE_HASHES=
AUTH_SECRET=
# 코드별로 다른 API 키를 쓸 때만 채운다. "code_id:api_key,code_id:api_key" 형식.
# 비어 있으면 모든 코드가 위 LLM_API_KEY/IMAGE_API_KEY를 공유한다.
CODE_API_KEYS=
IMAGE_BUDGET_SESSIONS=3
STORAGE_PATH=./storage
# 비워두면 /admin, /api/admin/usage 전체가 비활성화된다.
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://quoding.com
